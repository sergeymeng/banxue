{
  "name": "private-tutor-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/copy-assets.mjs",
    "postinstall": "npm run assets",
    "test:e2e": "playwright test",
    "test:voice-sim": "playwright test --config playwright.voice.config.ts"
  },
  "dependencies": {
    "@ricky0123/vad-web": "^0.0.31",
    "@tldraw/assets": "^5.6.0",
    "next": "16.4.3",
    "onnxruntime-web": "^1.31.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tldraw": "5.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5.9.3",
    "vitest": "5.0.5"
  },
  "type": "module"
}
