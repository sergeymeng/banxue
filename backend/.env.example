# Copy to backend/.env. Never put API keys in frontend or Git.
MODEL_MODE=demo
DATA_DIR=data
# For actual calls: MODEL_MODE=live. Prices below are GBP per 1,000,000 tokens.
# Fill current prices yourself (convert currency if necessary). Unknown prices block requests.
FAST_BASE_URL=https://api.openai.com/v1
FAST_MODEL=gpt-4.1-mini
FAST_API_KEY=
# FAST_INPUT_GBP=
# FAST_OUTPUT_GBP=
# FAST_CACHED_GBP=
REASONING_BASE_URL=https://api.openai.com/v1
REASONING_MODEL=gpt-4.1
REASONING_API_KEY=
# REASONING_INPUT_GBP=
# REASONING_OUTPUT_GBP=
VISION_BASE_URL=https://api.openai.com/v1
VISION_MODEL=gpt-4.1-mini
VISION_API_KEY=
# VISION_INPUT_GBP=
# VISION_OUTPUT_GBP=
# VISION_CACHED_GBP=
COMPLETION_TOKEN_FIELD=max_completion_tokens
REQUEST_BUDGET_GBP=0.15
SESSION_BUDGET_GBP=3
DAILY_BUDGET_GBP=5
CONTEXT_TOKENS=4200
MAX_OUTPUT_TOKENS=700
VISION_TOKEN_ALLOWANCE=6000
HISTORY_MESSAGES=8
RETAIN_TRANSCRIPTS=true
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional Qwen cloud voice (independent from existing text/vision configuration).
# Apply the preset explicitly in desktop Settings; these are Beijing CNY prices checked 2026-10-30.
VOICE_ENABLED=false
VOICE_REGION=beijing
VOICE_API_KEY=
VOICE_WORKSPACE=
VOICE_LLM_MODEL=qwen-flash
VOICE_ASR_MODEL=qwen-audio-3.0-asr-flash-streaming
VOICE_TTS_MODEL=qwen3-tts-flash-realtime
VOICE_VOICE=Cherry
VOICE_INPUT_CNY=0.15
VOICE_OUTPUT_CNY=1.5
VOICE_ASR_CNY_SECOND=0.00033
VOICE_TTS_CNY_10K=1
# Explicit budgeting assumption, NOT a live FX quote. Set to your chosen conversion.
VOICE_CNY_TO_GBP=0.12
VOICE_SESSION_SECONDS=1800
VOICE_UTTERANCE_SECONDS=60

# Structured multi-line region transcription, included in budget reservation.
VISION_MAX_OUTPUT_TOKENS=4096
# Opt-in only. Existing providers/settings are never rewritten; see docs/QWEN_VISION.md.
# VISION_ADAPTER=qwen_vl
